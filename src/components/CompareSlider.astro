---
/**
 * Before/after comparison.
 *
 * - Sweeps once when it scrolls into view (skipped for reduced motion), then
 *   the visitor takes over.
 * - Horizontal handle on desktop (drag anywhere); vertical handle on phones so
 *   the portrait photos show in full (drag the knob; press and hold anywhere to
 *   see "before").
 * - Keyboard: the stage is a slider (arrows, Home, End).
 *
 * The clip position is one CSS variable (--pos, 0–100); the orientation is
 * decided in CSS, so the script never has to know which layout is active.
 */
import { Image } from 'astro:assets';
import before from '../assets/images/compare-before.jpg';
import after from '../assets/images/compare-after.jpg';

interface Props {
  caption?: string;
}
const { caption = 'Real before/after from a recent job.' } = Astro.props;
const imgProps = { width: 1200, widths: [480, 800, 1200], sizes: '(min-width: 70em) 1072px, 100vw', quality: 66, loading: 'lazy' as const };
---

<figure class="compare">
  <div
    class="stage"
    data-compare
    role="slider"
    tabindex="0"
    aria-label="Before and after comparison"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    style="--pos: 50">
    <Image src={after} alt="After detailing: clean floor and seat" class="img" {...imgProps} />
    <div class="before-wrap" aria-hidden="true">
      <Image src={before} alt="" class="img" {...imgProps} />
    </div>
    <div class="handle" aria-hidden="true">
      <div class="knob" data-compare-knob>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="8 7 3 12 8 17"></polyline>
          <polyline points="16 7 21 12 16 17"></polyline>
        </svg>
      </div>
    </div>
    <span class="tag tag-before mono" aria-hidden="true">Before</span>
    <span class="tag tag-after mono" aria-hidden="true">After</span>
    <span class="hint hint-h mono" aria-hidden="true">Drag to compare</span>
    <span class="hint hint-v mono" aria-hidden="true">Drag the handle · hold to see before</span>
  </div>
  <figcaption class="muted">{caption}</figcaption>
</figure>

<style>
  .compare {
    margin: 0;
  }
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-height: 640px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    user-select: none;
    -webkit-user-select: none;
    background: var(--bg-elevated-2);
    touch-action: pan-y;
    cursor: ns-resize;
  }
  .stage:focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 3px;
  }
  .stage :global(.img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .before-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* vertical: "before" fills from the top down to --pos */
    clip-path: inset(0 0 calc(100% - var(--pos) * 1%) 0);
  }
  .handle {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--pos) * 1%);
    height: 0;
    pointer-events: none;
  }
  .handle::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    transform: translateY(-50%);
    background: var(--foam);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4);
  }
  .knob {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--metal);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
  }
  .knob svg {
    transform: rotate(90deg);
  }
  .stage[data-dragging] .knob {
    cursor: grabbing;
  }
  .tag,
  .hint {
    position: absolute;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--foam);
    background: rgba(10, 10, 10, 0.65);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    pointer-events: none;
  }
  .tag-before {
    top: 12px;
    left: 12px;
  }
  .tag-after {
    bottom: 12px;
    right: 12px;
  }
  .hint {
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    white-space: nowrap;
    color: var(--muted);
    transition: opacity 0.3s ease;
  }
  .hint-h {
    display: none;
  }
  .stage[data-touched] .hint {
    opacity: 0;
  }
  figcaption {
    font-size: 13px;
    margin-top: var(--space-3);
    max-width: 520px;
  }

  /* ---- desktop: horizontal handle, drag anywhere ---- */
  @media (min-width: 55em) {
    .stage {
      aspect-ratio: 3 / 2;
      cursor: ew-resize;
    }
    .before-wrap {
      clip-path: inset(0 calc(100% - var(--pos) * 1%) 0 0);
    }
    .handle {
      left: calc(var(--pos) * 1%);
      right: auto;
      top: 0;
      bottom: 0;
      height: auto;
      width: 0;
    }
    .handle::before {
      top: 0;
      bottom: 0;
      left: 0;
      right: auto;
      width: 2px;
      height: auto;
      transform: translateX(-50%);
    }
    .knob {
      top: 50%;
      left: 0;
      width: 44px;
      height: 44px;
    }
    .knob svg {
      transform: none;
    }
    .tag-after {
      top: 12px;
      bottom: auto;
    }
    .hint-h {
      display: block;
    }
    .hint-v {
      display: none;
    }
  }
</style>

<script>
  const clamp = (v: number) => Math.max(0, Math.min(100, v));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const vertical = window.matchMedia('(max-width: 54.99em)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const stage of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    let pos = 50;
    let raf = 0;
    let interacted = false;

    const set = (v: number) => {
      pos = clamp(v);
      stage.style.setProperty('--pos', String(pos));
      stage.setAttribute('aria-valuenow', String(Math.round(pos)));
    };
    const stopAnim = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const animateTo = (target: number, ms: number, done?: () => void) => {
      stopAnim();
      if (reducedMotion) {
        set(target);
        done?.();
        return;
      }
      const from = pos;
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / ms);
        set(from + (target - from) * easeOut(t));
        if (t < 1) raf = requestAnimationFrame(step);
        else done?.();
      };
      raf = requestAnimationFrame(step);
    };
    const orient = () => stage.setAttribute('aria-orientation', vertical.matches ? 'vertical' : 'horizontal');
    orient();
    vertical.addEventListener('change', orient);

    // 1. One sweep when the comparison scrolls into view, unless the visitor got there first.
    if (!reducedMotion && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry], io) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          if (interacted) return;
          set(0);
          animateTo(100, 1200, () => {
            if (!interacted) animateTo(50, 700);
          });
        },
        { threshold: 0.6 },
      ).observe(stage);
    }

    // 2 + 3. Pointer handling: desktop drags anywhere; phones drag the knob or press-and-hold to peek at "before".
    const posFromEvent = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      return vertical.matches ? ((e.clientY - r.top) / r.height) * 100 : ((e.clientX - r.left) / r.width) * 100;
    };
    let dragging = false;
    let holdTimer = 0;
    let holding = false;
    let posBeforeHold = 50;
    let startX = 0;
    let startY = 0;
    const HOLD_MS = 180;
    const HOLD_SLOP = 8;

    const touch = () => {
      interacted = true;
      stage.setAttribute('data-touched', '');
      stopAnim();
    };

    stage.addEventListener('pointerdown', (e) => {
      touch();
      startX = e.clientX;
      startY = e.clientY;
      const onKnob = !!(e.target as Element).closest('[data-compare-knob]');
      if (onKnob || !vertical.matches) {
        dragging = true;
        stage.setAttribute('data-dragging', '');
        try {
          stage.setPointerCapture(e.pointerId);
        } catch {}
        set(posFromEvent(e));
        e.preventDefault();
        return;
      }
      // hold to compare (vertical layout, anywhere off the knob)
      posBeforeHold = pos;
      holdTimer = window.setTimeout(() => {
        holdTimer = 0;
        holding = true;
        animateTo(100, 220);
      }, HOLD_MS);
    });

    stage.addEventListener('pointermove', (e) => {
      if (dragging) {
        set(posFromEvent(e));
        return;
      }
      if (holdTimer && (Math.abs(e.clientX - startX) > HOLD_SLOP || Math.abs(e.clientY - startY) > HOLD_SLOP)) {
        clearTimeout(holdTimer); // the finger is scrolling, not holding
        holdTimer = 0;
      }
    });

    const release = (e: PointerEvent) => {
      if (dragging) {
        dragging = false;
        stage.removeAttribute('data-dragging');
        try {
          stage.releasePointerCapture(e.pointerId);
        } catch {}
      }
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = 0;
      }
      if (holding) {
        holding = false;
        animateTo(posBeforeHold, 280);
      }
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
    stage.addEventListener('lostpointercapture', release);
    stage.addEventListener('contextmenu', (e) => e.preventDefault()); // long-press on phones

    // Keyboard: the stage is the slider.
    stage.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 5;
      let next: number | null = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = pos + step;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = pos - step;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = 100;
      if (next === null) return;
      e.preventDefault();
      touch();
      set(next);
    });

    set(50);
  }
</script>
