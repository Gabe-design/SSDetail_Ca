---
/** Photo grid with captions — 1 column on phones, 2 at 640px, 3 at 880px. */
import { Image } from 'astro:assets';
import type { GalleryItem } from '../data/gallery';
interface Props {
  items: GalleryItem[];
  /** First row loads eagerly when the gallery is near the top of a page. */
  eager?: number;
}
const { items, eager = 0 } = Astro.props;
---

<ul class="gallery">
  {
    items.map((item, i) => (
      <li class="card card--hover">
        <figure>
          <Image
            src={item.image}
            alt={item.alt}
            widths={[360, 540, 720]}
            sizes="(min-width: 55em) 350px, 50vw"
            quality={72}
            loading={i < eager ? 'eager' : 'lazy'}
            style={item.position ? `object-position:${item.position}` : undefined}
          />
          <figcaption>{item.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  figure {
    margin: 0;
  }
  li {
    overflow: hidden;
  }
  li :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    object-position: center;
  }
  figcaption {
    padding: 10px 12px;
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (min-width: 40em) {
    .gallery {
      gap: var(--space-5);
    }
    figcaption {
      padding: 12px 16px;
      font-size: 13.5px;
    }
  }
  @media (min-width: 55em) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
    li :global(img) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
