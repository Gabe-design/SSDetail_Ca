---
import Logo from './Logo.astro';
import { navItems } from '../data/nav';
import { business, formatPhone } from '../data/business';

const year = new Date().getFullYear();
const owner = business.legalName ?? business.name;
const modelLine =
  business.serviceModel === 'mobile'
    ? 'Mobile detailing. We come to you.'
    : business.serviceModel === 'shop'
      ? 'Drop-off detailing'
      : business.serviceModel === 'both'
        ? 'Mobile & drop-off detailing'
        : null;
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo size={28} class="small" />
      <p class="muted tagline">{business.tagline}</p>
      {modelLine && <p class="muted">{modelLine}</p>}
      {business.serviceArea && <p class="muted">Serving {business.serviceArea}</p>}
    </div>

    <nav class="foot-nav" aria-label="Footer">
      <span class="label">Pages</span>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="contact">
      <span class="label">Contact</span>
      <ul>
        {
          business.phone && (
            <li>
              <a href={`tel:${business.phone}`}>{formatPhone(business.phone)}</a>
            </li>
          )
        }
        <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
        {business.hours && <li class="muted">{business.hours}</li>}
        {
          business.instagram && (
            <li>
              <a href={business.instagram} rel="me noopener" target="_blank" class="social">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span>Instagram</span>
                <span class="handle">@{business.instagramHandle}</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <span class="mono">© {year} {owner}. All rights reserved.</span>
    <a class="mono credit" href="https://mrdstudios.tech" target="_blank" rel="noopener">
      Powered by <span class="credit-name">MRD Studios</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid transparent;
    border-image: var(--line-gradient) 1;
    padding-block: var(--space-7) var(--space-6);
    margin-top: auto;
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  .brand .tagline {
    margin-top: var(--space-3);
  }
  .brand p {
    font-size: 14px;
  }
  .label {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  ul {
    display: grid;
    gap: 2px;
  }
  li {
    font-size: 14px;
    color: var(--muted);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .social {
    gap: 8px;
  }
  .social svg {
    flex-shrink: 0;
  }
  .social .handle {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    opacity: 0.8;
  }
  a:hover {
    color: var(--foam);
  }
  .legal {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    font-size: 12.5px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    justify-content: space-between;
    align-items: center;
  }
  .credit {
    /* the footer's generic link rule makes this inline-flex, which strips the space
       before the <span>; a gap puts it back, and margin-left pins it to the right */
    display: inline-flex;
    gap: 0.4em;
    margin-left: auto;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .credit-name {
    color: var(--foam);
  }
  .credit:hover .credit-name {
    color: var(--accent-bright);
  }
  .legal::before {
    content: '';
    display: block;
    height: 1px;
    background: var(--line);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 40em) {
    .grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
