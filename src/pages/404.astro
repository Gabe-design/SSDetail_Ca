---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">404</span>
        <h1>Wrong turn</h1>
        <p>That link is old or mistyped. Head home or go straight to pricing.</p>
        <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px;">
          <a class="btn btn-primary" href="/">Home</a>
          <a class="btn btn-ghost" href="/services">See Pricing</a>
        </p>
      </div>
    </div>
  </section>
</Base>
