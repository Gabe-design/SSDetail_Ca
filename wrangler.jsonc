{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ssdetail-ca",
	"compatibility_date": "2026-09-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// ---------------------------------------------------------------------------
	// TESTING (default environment): `npx wrangler deploy`
	// Worker "ssdetail-ca" at ssdetail-ca.<account>.workers.dev. Quote emails go to Gabe.
	// Resend's test sender only delivers to the Resend account owner, so this works before
	// the domain is verified.
	// ---------------------------------------------------------------------------
	"vars": {
		"QUOTE_TO": "gabrielaross8@gmail.com",
		"RESEND_FROM": "SS Detail Website <onboarding@resend.dev>",
		"SEND_CUSTOMER_CONFIRMATION": "false"
	},

	// ---------------------------------------------------------------------------
	// PRODUCTION: `npx wrangler deploy --env production`
	// A separate Worker "ssdetail-ca-production" with its own vars and secrets, serving
	// ssdetail.com once the domain is on Cloudflare (uncomment "routes"). Quote emails go
	// to the client from the verified domain. Environments do not inherit "vars", so all
	// three are repeated here on purpose. Secrets: `npx wrangler secret bulk .dev.vars --env production`.
	// ---------------------------------------------------------------------------
	"env": {
		"production": {
			"name": "ssdetail-ca-production",
			"vars": {
				"QUOTE_TO": "sscardetailingca@gmail.com",
				"RESEND_FROM": "SS Detail Website <quotes@ssdetail.com>",
				"SEND_CUSTOMER_CONFIRMATION": "false"
			}
			// "routes": [
			// 	{ "pattern": "ssdetail.com", "custom_domain": true },
			// 	{ "pattern": "www.ssdetail.com", "custom_domain": true }
			// ]
		}
	}
}
