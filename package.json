{
  "name": "ssdetail-ca",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "brand": "node scripts/build-brand.mjs",
    "check": "astro check",
    "build:production": "cross-env CLOUDFLARE_ENV=production astro build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy --env production",
    "secrets": "wrangler secret bulk .dev.vars",
    "secrets:production": "wrangler secret bulk .dev.vars --env production"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cross-env": "^10.1.0",
    "opentype.js": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
